{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@hitbot/domain": ["../../packages/domain/src/index.ts"]
    },
    "types": ["@tarojs/taro", "@types/react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "config/**/*.ts", "app.config.ts"],
  "references": []
}
